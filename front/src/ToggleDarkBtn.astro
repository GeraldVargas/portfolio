<script>
  const d = document;
  const checkbox = d.querySelector("[data-toogle]") as HTMLInputElement;

  function shortCircuit() {
    const audio = new Audio();
    audio.src = "../sounds/short_circuit.mp3";
    audio.volume -= 0.6;
    audio.play();
    setTimeout(() => audio.pause(), 1900);
  }

  function playSound() {
    const audio = new Audio();
    audio.src = "../sounds/franks-electricity.mp3";
    audio.volume -= 0.7;
    audio.play();
  }

  let clickCount = 0;
  let darkModeState = false;

  function toggleDarkMode(state: boolean) {
    d.documentElement.classList.toggle("dark-mode", state);
    darkModeState = state;
    checkbox.checked = state;
  }

  function setDarkModeLocalStorage(state: boolean) {
    localStorage.setItem("dark-mode", String(state));
  }

  toggleDarkMode(localStorage.getItem("dark-mode") === "true");

  const useDark = window.matchMedia("(prefers-color-scheme: dark)");
  useDark.addEventListener("change", (evt) => toggleDarkMode(evt.matches));

  checkbox.addEventListener("change", () => {
    clickCount += 1;

    if (clickCount <= 8) {
      playSound();
      toggleDarkMode(checkbox.checked);
      setDarkModeLocalStorage(checkbox.checked);
      return;
    }

    if (clickCount <= 15) {
      shortCircuit();
      d.documentElement.classList.add("short-circuit");
      d.documentElement.classList.remove("dark-mode");
      checkbox.checked = false;
      return;
    }

    alert("You messed up. Click here to reload");
    location.reload();
  });
</script>

<div class="toogle-dark__container container" transition:persist>
  <input id="checkbox" type="checkbox" data-toogle transition:persist />
  <label for="checkbox" class="label" aria-label="Toggle dark mode"></label>
</div>

<style>
  .toogle-dark__container {
    z-index: 999;
    position: fixed;
    bottom: 17%;
    right: 2%;
    animation: scale-up-center 0.3s ease-in 2s backwards;
  }

  .label {
    height: 30px;
    width: 60px;
    background-color: #ffffff;
    border-radius: 15px;
    box-shadow:
      inset 0 0 3px 2px rgba(255, 255, 255, 1),
      inset 0 0 20px 1px rgba(0, 0, 0, 0.488),
      6px 12px 20px rgba(0, 0, 0, 0.12),
      inset 0 0 0 2px rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    cursor: pointer;
    position: relative;
    transition: transform 0.4s;
  }

  .label:hover {
    transform: perspective(100px) rotateX(5deg) rotateY(-5deg);
  }

  #checkbox:checked ~ .label:hover {
    transform: perspective(100px) rotateX(-5deg) rotateY(5deg);
  }

  #checkbox {
    display: none;
  }

  #checkbox:checked ~ .label::before {
    left: 35px;
    background-color: #000000;
    background-image: linear-gradient(315deg, #000000 0%, #414141 70%);
    transition: 0.4s;
  }

  .label::before {
    position: absolute;
    content: "";
    height: 20px;
    width: 20px;
    border-radius: 50%;
    background-color: #000000;
    background-image: linear-gradient(130deg, #757272 10%, #ffffff 11%, #726f6f 62%);
    left: 5px;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.3), 5px 5px 6px rgba(0, 0, 0, 0.3);
    transition: 0.4s;
  }

  @keyframes scale-up-center {
    0% {
      transform: scale(0);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (max-width: 768px) {
    .toogle-dark__container {
      bottom: 11%;
      right: 2%;
      transform: none;
    }
  }
</style>
