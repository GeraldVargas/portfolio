---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import BtnToTop from "@atoms/BtnToTop.astro";
import "../styles/pages/portfolio.css";
import NavLinks from "../components/NavLinks.astro";
import { portfolio } from "../data/MenuData";
import PortfolioCards from "../components/PortfolioCards.astro";

// Misma paleta de colores que usan las cards de proyectos
const palette = ["#01f2ff", "#ff6b35", "#ff9d00", "#ffd60a", "#ea4b71", "#a855f7", "#2ecc71", "#e74c3c"];

const filterSkills = [
  { slug: "flutter", label: "Flutter" },
  { slug: "laravel", label: "Laravel" },
  { slug: "react", label: "React" },
  { slug: "nodedotjs", label: "Node.js" },
  { slug: "python", label: "Python" },
  { slug: "tailwindcss", label: "Tailwind" },
  { slug: "javascript", label: "JavaScript" },
  { slug: "mysql", label: "MySQL" },
  { slug: "tensorflow", label: "TensorFlow" },
  { slug: "streamlit", label: "Streamlit" },
  { slug: "bluetooth", label: "Bluetooth" },
  { slug: "n8n", label: "n8n" },
].map((skill, index) => ({ ...skill, color: palette[index % palette.length] }));
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <NavLinks origin={portfolio} />
    <BtnToTop />
    <main>
      <section class="portfolio__padre">
        <div class="portfolio__noise-bg" aria-hidden="true"></div>

        <h1 class="titulo titulo__dark btn-shine">
          Proyectos
        </h1>

        <div class="buttons__container">
          <div class="btn__caja">
            <button class="skill-button" data-filter-all type="button">All</button>
            {filterSkills.map((skill) => (
              <button
                class="skill-button"
                data-filter={skill.slug}
                style={`--skill-color: ${skill.color};`}
                type="button"
              >
                <img
                  src={`https://cdn.simpleicons.org/${skill.slug}/ffffff`}
                  alt=""
                  width="16"
                  height="16"
                />
                {skill.label}
              </button>
            ))}
          </div>
        </div>

        <div class="cards__container portafolio__contenedor" data-card>
          <PortfolioCards />
        </div>
      </section>
    </main>
    <Footer />

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const allBtn = document.querySelector("[data-filter-all]");
        const filterBtns = document.querySelectorAll("[data-filter]");
        const cards = document.querySelectorAll(".pf-card[data-skills]");

        function setActive(btn) {
          document.querySelectorAll(".skill-button").forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
        }

        allBtn?.addEventListener("click", () => {
          setActive(allBtn);
          cards.forEach((card) => ((card as HTMLElement).style.display = ""));
        });

        filterBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            setActive(btn);
            const skill = btn.getAttribute("data-filter");
            cards.forEach((card) => {
              const skills = (card.getAttribute("data-skills") || "").split(",");
              (card as HTMLElement).style.display = skills.includes(skill!) ? "" : "none";
            });
          });
        });

        if (allBtn) setActive(allBtn);
      });
    </script>
  </body>
</html>