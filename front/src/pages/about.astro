---
import "../styles/about-section.css";
import YoutubeLastvid from "../components/YoutubeLastvid.astro";
import BaseHead from "../components/BaseHead.astro";
import ToogleDarkBtn from "../ToggleDarkBtn.astro";
import BtnToTop from "@atoms/BtnToTop.astro";
import Footer from "../components/Footer.astro";
import DarkBg from "../components/DarkBg.astro";
import NavLinks from "../components/NavLinks.astro";
import CardTerminal from "../layouts/CardTerminal.astro";
import ContactSocialIcons from "../components/ContactSocialIcons.astro";
import VsCodeTheme from "../components/VsCodeTheme.astro"
import Divider4 from "../components/atoms/Dividers/Divider4.astro";
import { about } from "../data/MenuData";
import DividerTop from "../components/atoms/Dividers/DividerTop.astro";
const { title, description } = Astro.props;


---


<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <NavLinks origin={about} />
    <ToogleDarkBtn />
    <BtnToTop />
    <main>
      <section class="about__intro" id="about">
        <div class=" about__imageIcons" ata-aos="fade-up">
          <img
            class="about__profile"
            src="../img/gerald.png"
            alt="Gerald Vargas portrait"
          />
          <div class="icons__container">
            <ContactSocialIcons />
          </div>
        </div>
        <CardTerminal >
          <h2 class="about__titulo--post post__titulo">
            Gerald <span class="span__dark" id="span-titulo2">Vargas</span>
          </h2>
          <p class="terminal__content terminal__content--p">
            ≥ Final-year <span class="terminal__content terminal__content--span">Computer Engineering student</span>
            at Universidad Mayor de San Simón (UMSS), focused on building real software with production quality.
          </p>
          <p class="terminal__content terminal__content--color">
            Strong foundation in Python, PHP, Laravel, Node.js, React, Flutter,
            MySQL, PostgreSQL, TensorFlow, Docker, and Astro.
          </p>
          <p class="terminal__content terminal__content--p">
            I have experience in high-criticality projects including electoral systems,
            municipal mobility apps, and educational platforms.
          </p>
          <p class="terminal__content terminal__content--color">
            My main focus is Applied AI and Machine Learning, integrating intelligent
            features into practical full stack products.
          </p>
        </CardTerminal>
      </section>
      <Divider4/>
      <VsCodeTheme/>
      <DividerTop colorLight="fill__black" colorDark="dark__black" dividerBg="black" dividerBgDark="" />
      <section class="about__page" id="ytChannel">
        <YoutubeLastvid />
      </section>
      <section class="about__text"></section>
    </main>
    <DarkBg />
    <Footer />
    <style>
      .about__page {
        width: 100%;
        padding: 1rem .4rem 0 .4rem;
        height: auto;
      }
      .post__titulo {
        color: white;
      }
      .text_content {
        color: white;
      }
      @media screen and (min-width: 768px) {
        .about__page {
        width: 100%;
        padding: 1rem 2rem 0 2rem;
        height: auto;
      }
      }
    </style>

  </body>
</html>
