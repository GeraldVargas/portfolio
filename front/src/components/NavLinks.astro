---
import Header from "../layouts/Header.astro";

const { origin, target } = Astro.props;
const linkKeyByHref = {
  "#hero": "inicio",
  "#about": "about",
  "#portafolio": "portfolio",
  "#contact": "contact",
  "/": "home",
  "https://github.com/GeraldVargas": "mygithub",
};
---

<Header>
  {
    origin.map((link, index) => {
      const i18nKey = linkKeyByHref[link.href];
      return (
        <>
          <li class="menu__list">
            {link.target == "_blank" ? (
              <a
                class="menu__link menu__hamburger-link button"
                target={link.target}
                rel="nofollow noreferrer noopener"
                href={link.href}
                data-i18n-key={i18nKey}
              >
                <div class="button-outer">
                  <div class="button-inner">
                    <span class="button-label">{link.text}</span>
                  </div>
                </div>
              </a>
            ) : (
              <a
                class="menu__link menu__hamburger-link button"
                target={link.target}
                href={link.href}
                data-i18n-key={i18nKey}
              >
                <div class="button-outer">
                  <div class="button-inner">
                    <span class="button-label">{link.text}</span>
                  </div>
                </div>
              </a>
            )}
          </li>
          {index === origin.length - 1 ? (
            <li class="menu__list menu__list--lang" aria-label="Language selector">
              <div class="lang-switcher">
                <div class="radio-input" role="radiogroup" aria-label="Language selector">
                  <div class="glass">
                    <div class="glass-inner"></div>
                  </div>
                  <div class="selector">
                    <label class="choice">
                      <div>
                        <input
                          class="choice-circle"
                          type="radio"
                          name="site-lang"
                          value="en"
                          checked
                        />
                        <div class="ball"></div>
                      </div>
                      <span class="choice-name">EN</span>
                    </label>
                    <label class="choice">
                      <div>
                        <input
                          class="choice-circle"
                          type="radio"
                          name="site-lang"
                          value="es"
                        />
                        <div class="ball"></div>
                      </div>
                      <span class="choice-name">ES</span>
                    </label>
                  </div>
                </div>
              </div>
            </li>
          ) : null}
        </>
      );
    })
  }
</Header>

<script type="module">
  const translations = {
    // Navigation
    inicio: { en: "Home", es: "Inicio" },
    skills: { en: "Skills", es: "Habilidades" },
    tools: { en: "Tools", es: "Herramientas" },
    about: { en: "Who is GeraldDev", es: "Quién es GeraldDev" },
    portfolio: { en: "Portfolio", es: "Portafolio" },
    contact: { en: "Contact", es: "Contáctame" },
    home: { en: "Home", es: "Inicio" },
    mygithub: { en: "My GitHub", es: "Mi GitHub" },

    // Hero
    hero_greeting: { en: "≥ Hi! I'm", es: "≥ ¡Hola! Soy" },
    hero_name: { en: "Gerald Vargas", es: "Gerald Vargas" },
    hero_role: { en: "≥ Full Stack Developer · Applied AI", es: "≥ Desarrollador Full Stack · IA Aplicada" },
    hero_sub: { en: "Computer Engineering Student · Cochabamba, Bolivia", es: "Estudiante de Ingeniería Informática · Cochabamba, Bolivia" },

    // Who is GeraldDev
    gerald_name: { en: "Gerald", es: "Gerald" },
    card_role: { en: "Full Stack Developer · Applied AI", es: "Desarrollador Full Stack · IA Aplicada" },
    card_email: { en: "Email", es: "Correo" },
    card_cv: { en: "Download CV", es: "Descargar CV" },
    terminal_h3_1: { en: "≥ Gerald Emanuel Vargas", es: "≥ Gerald Emanuel Vargas" },
    terminal_p_1: { en: "≥ Python & Laravel fan 🤖. Always building things that matter.", es: "≥ Fanático de Python y Laravel 🤖. Siempre construyendo cosas que importan." },
    terminal_h3_2_pre: { en: "≥ What ", es: "≥ ¿Qué " },
    terminal_h3_2_span: { en: "sets me apart?", es: "me diferencia?" },
    terminal_p_2: { en: "≥ I've deployed real systems used in official elections 🗳️ and municipal governments. I build for production, not just for practice.", es: "≥ He desplegado sistemas reales usados en elecciones oficiales 🗳️ y gobiernos municipales. Construyo para producción, no solo por práctica." },

    // Tools & Skills
    tools_title: { en: "Tools", es: "Herramientas" },
    skills_title: { en: "Skills", es: "Habilidades" },

    // Portfolio
    portfolio_title: { en: "Portfolio", es: "Portafolio" },
    portfolio_see_more: { en: "See More", es: "Ver Más" },
    view_demo: { en: "View Demo", es: "Ver Demo" },
    view_repo: { en: "View Repo", es: "Ver Repo" },
    all_filter: { en: "All", es: "Todos" },
    ver_detalle: { en: "View Details", es: "Ver Detalle" },
    modal_techs_label: { en: "Technologies", es: "Tecnologías" },
    modal_links_label: { en: "Links", es: "Enlaces" },

    desc_synapse: {
      en: "Full-featured Learning Management System with role-based access, automated assessments, and admin dashboards.",
      es: "Sistema de gestión de aprendizaje completo con acceso basado en roles, evaluaciones automatizadas y paneles de administración."
    },
    desc_colcatrufi: {
      en: "Cross-platform urban mobility app for the Municipal Government of Colcapirhua.",
      es: "Aplicación de movilidad urbana multiplataforma para el Gobierno Autónomo Municipal de Colcapirhua."
    },
    desc_fraud: {
      en: "Deep Learning system (Autoencoder + Isolation Forest) with 94.2% precision on 150,000+ transactions.",
      es: "Sistema de aprendizaje profundo (Autoencoder + Isolation Forest) con 94.2% de precisión en más de 150,000 transacciones."
    },
    desc_electoral: {
      en: "Official system used in the Cochabamba 2026 Sub-national Elections with real-time results dashboard.",
      es: "Sistema oficial utilizado en las Elecciones Subnacionales Cochabamba 2026 con tablero de resultados en tiempo real."
    },

    // Contact
    contact_title: { en: "Contact me", es: "Contáctame" },
    contact_subtitle: { en: "Send me a message for projects, collaborations or inquiries", es: "Ponte en contacto para proyectos, colaboraciones o consultas" },
    contact_name_placeholder: { en: "Your Name", es: "Tu Nombre" },
    contact_email_placeholder: { en: "Your Email", es: "Tu Correo Electrónico" },
    contact_message_placeholder: { en: "Your Message...", es: "Tu Mensaje..." },
    contact_send_btn: { en: "SEND MESSAGE", es: "ENVIAR MENSAJE" },

    // Footer
    footer_email: { en: "Email", es: "Correo" }
  };

  const setLanguage = (lang) => {
    document.documentElement.lang = lang;
    document.querySelectorAll("[data-i18n-key]").forEach((node) => {
      const key = node.getAttribute("data-i18n-key");
      const label = translations[key]?.[lang];
      if (!label) return;
      const labelNode = node.querySelector(".button-label");
      if (labelNode) {
        labelNode.textContent = label;
        return;
      }
      node.textContent = label;
    });

    document.querySelectorAll("[data-i18n-placeholder]").forEach((node) => {
      const key = node.getAttribute("data-i18n-placeholder");
      const label = translations[key]?.[lang];
      if (label) {
        node.setAttribute("placeholder", label);
      }
    });

    window.dispatchEvent(new CustomEvent("languageChange", { detail: { lang } }));
  };

  const savedLang = localStorage.getItem("site-lang");
  const initialLang = savedLang === "es" ? "es" : "en";
  const activeRadio = document.querySelector(
    `input[name="site-lang"][value="${initialLang}"]`
  );
  if (activeRadio) activeRadio.checked = true;
  setLanguage(initialLang);

  document.querySelectorAll('input[name="site-lang"]').forEach((radio) => {
    radio.addEventListener("change", (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;
      if (!event.target.checked) return;
      const lang = event.target.value;
      localStorage.setItem("site-lang", lang);
      setLanguage(lang);
    });
  });
</script>
