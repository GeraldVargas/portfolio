    ],
    demoUrl: "",
    repoUrl: "",
  },
  {
    id: "deteccion-fraude",
    title: "Detección de Fraude Financiero con Deep Learning",
    description:
      "Sistema híbrido Isolation Forest + Autoencoder (arquitectura 20-12-8-12-20) para detección de anomalías en transacciones. Pipeline diseñado para datos desbalanceados (fraude <0.1%), alcanzando 94.2% de precisión y 91.8% de recall sobre más de 150,000 transacciones. Dashboard interactivo en Streamlit con visualización de anomalías y scoring de riesgo adaptativo.",
    technologies: [
      { name: "Python", icon: "https://cdn.simpleicons.org/python/01f2ff" },
      { name: "TensorFlow", icon: "https://cdn.simpleicons.org/tensorflow/01f2ff" },
      { name: "Scikit-learn", icon: "https://cdn.simpleicons.org/scikitlearn/01f2ff" },
      { name: "Streamlit", icon: "https://cdn.simpleicons.org/streamlit/01f2ff" },
    ],
    demoUrl: "",
    repoUrl: "",
  },
];

const proyectosAMostrar = limit ? projects.slice(0, limit) : projects;
---

{proyectosAMostrar.map((proyecto) => (
  <>
    <div class="pf-card" data-modal-target={proyecto.id}>
      <div class="pf-card__shadow"></div>

      <div class="pf-card__main">
        <div class="pf-card__top"></div>
        <div class="pf-card__side pf-card__side--left"></div>
        <div class="pf-card__side pf-card__side--right"></div>

        <h3 class="pf-card__title">{proyecto.title}</h3>

        <div class="pf-card__techs">
          {proyecto.technologies.slice(0, 4).map((tech) => (
            <span class="pf-card__tech-icon" title={tech.name}>
              <img src={tech.icon} alt={tech.name} width="20" height="20" />
            </span>
          ))}
        </div>

        <div class="pf-card__btn-wrap">
          <button class="pf-card__btn" data-open-modal={proyecto.id} type="button">
            Ver detalle
          </button>
        </div>
      </div>
    </div>

    <!-- Modal de detalle de este proyecto -->
    <div class="pf-modal-overlay" id={`modal-${proyecto.id}`} data-modal-overlay={proyecto.id}>
      <div class="pf-modal">
        <button class="pf-modal__close" data-close-modal={proyecto.id} type="button" aria-label="Cerrar">
          ✕
        </button>

        <div class="pf-modal__bar">
          <span class="pf-modal__dot pf-modal__dot--red"></span>
          <span class="pf-modal__dot pf-modal__dot--yellow"></span>
          <span class="pf-modal__dot pf-modal__dot--green"></span>
          <span class="pf-modal__bar-title">{proyecto.title}.detail</span>
        </div>

        <div class="pf-modal__body">
          <h2 class="pf-modal__project-name">{proyecto.title}</h2>
          <p class="pf-modal__desc">{proyecto.description}</p>

          <p class="pf-modal__label">Tecnologías utilizadas</p>
          <div class="pf-modal__techs">
            {proyecto.technologies.map((tech) => (
              <span class="pf-modal__tech-pill">
                <img src={tech.icon} alt={tech.name} width="18" height="18" />
                {tech.name}
              </span>
            ))}
          </div>

          <div class="pf-modal__links">
            {proyecto.demoUrl && (
              <a class="pf-modal__link" href={proyecto.demoUrl} target="_blank" rel="noopener noreferrer">
                Ver demo
              </a>
            )}
            {proyecto.repoUrl && (
              <a class="pf-modal__link" href={proyecto.repoUrl} target="_blank" rel="noopener noreferrer">
                Ver repositorio
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </>
))}

<script>
  // Delegación de eventos: funciona para todas las cards/modales de la página
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const openBtn = target.closest('[data-open-modal]') as HTMLElement | null;
    if (openBtn) {
      const modalId = openBtn.dataset.openModal;
      const overlay = document.querySelector(`[data-modal-overlay="${modalId}"]`);
      overlay?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      return;
    }

    const closeBtn = target.closest('[data-close-modal]') as HTMLElement | null;
    if (closeBtn) {
      const modalId = closeBtn.dataset.closeModal;
      const overlay = document.querySelector(`[data-modal-overlay="${modalId}"]`);
      overlay?.classList.remove('is-open');
      document.body.style.overflow = '';
      return;
    }

    // Cerrar al hacer click fuera del modal (en el overlay)
    if (target.classList.contains('pf-modal-overlay')) {
      target.classList.remove('is-open');
      document.body.style.overflow = '';
    }
  });

  // Cerrar con la tecla Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.pf-modal-overlay.is-open').forEach((overlay) => {
        overlay.classList.remove('is-open');
      });
      document.body.style.overflow = '';
    }
  });
</script>