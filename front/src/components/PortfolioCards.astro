const proyectosAMostrar = limit ? projects.slice(0, limit) : projects;
---

{proyectosAMostrar.map((proyecto) => {
  const skillsAttr = proyecto.technologies.map((t) => t.slug).join(",");
  const colorHex = `#${proyecto.color}`;
  return (
    <>
      <div
        class="pf-card"
        data-modal-target={proyecto.id}
        data-skills={skillsAttr}
        style={`--card-color: ${colorHex};`}
      >
        <div class="pf-card__shadow"></div>
        <div class="pf-card__main">
          <div class="pf-card__top"></div>
          <div class="pf-card__side pf-card__side--left"></div>
          <div class="pf-card__side pf-card__side--right"></div>
          <h3 class="pf-card__title">{proyecto.title}</h3>
          <div class="pf-card__techs">
            {proyecto.technologies.slice(0, 4).map((tech) => (
              <span class="pf-card__tech-icon" title={tech.name}>
                <img
                  src={`https://cdn.simpleicons.org/${tech.slug}/${proyecto.color}`}
                  alt={tech.name}
                  width="20"
                  height="20"
                />
              </span>
            ))}
          </div>
          <div class="pf-card__btn-wrap">
            <button class="pf-card__btn" data-open-modal={proyecto.id} type="button">
              Ver detalle
            </button>
          </div>
        </div>
      </div>

      <!-- Modal estilo TERMINAL (caja__cristal) -->
      <div
        class="pf-modal-overlay"
        id={`modal-${proyecto.id}`}
        data-modal-overlay={proyecto.id}
        style={`--card-color: ${colorHex};`}
      >
        <div class="caja__cristal pf-modal-terminal">
          <div class="terminal_toolbar">
            <div class="butt">
              <button class="btn btn__red" data-close-modal={proyecto.id} type="button" aria-label="Cerrar"></button>
              <button class="btn btn__yellow" type="button" aria-label="Minimizar" tabindex="-1"></button>
              <button class="btn btn__green" type="button" aria-label="Maximizar" tabindex="-1"></button>
            </div>
            <p class="user">{proyecto.title.toLowerCase().replace(/\s+/g, "-")}.sh</p>
          </div>

          <div class="terminal__container">
            <div class="terminal__content">
              <h3 class="terminal__content--h3">≥ {proyecto.title}</h3>
              <p class="terminal__content--p pf-modal-terminal__desc">{proyecto.description}</p>

              <p class="terminal__content--span pf-modal-terminal__label">≥ Tecnologías utilizadas</p>
              <div class="pf-modal__techs">
                {proyecto.technologies.map((tech) => (
                  <span class="pf-modal__tech-pill">
                    <img
                      src={`https://cdn.simpleicons.org/${tech.slug}/${proyecto.color}`}
                      alt={tech.name}
                      width="18"
                      height="18"
                    />
                    {tech.name}
                  </span>
                ))}
              </div>

              <div class="pf-modal__links">
                {proyecto.demoUrl && (
                  <a class="terminal__link pf-modal__link" href={proyecto.demoUrl} target="_blank" rel="noopener noreferrer">
                    ≥ Ver demo
                  </a>
                )}
                {proyecto.repoUrl && (
                  <a class="terminal__link pf-modal__link" href={proyecto.repoUrl} target="_blank" rel="noopener noreferrer">
                    ≥ Ver repositorio
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </>
  );
})}

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const openBtn = target.closest('[data-open-modal]') as HTMLElement | null;
    if (openBtn) {
      const modalId = openBtn.dataset.openModal;
      const overlay = document.querySelector(`[data-modal-overlay="${modalId}"]`);
      overlay?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      return;
    }

    const closeBtn = target.closest('[data-close-modal]') as HTMLElement | null;
    if (closeBtn) {
      const modalId = closeBtn.dataset.closeModal;
      const overlay = document.querySelector(`[data-modal-overlay="${modalId}"]`);
      overlay?.classList.remove('is-open');
      document.body.style.overflow = '';
      return;
    }

    if (target.classList.contains('pf-modal-overlay')) {
      target.classList.remove('is-open');
      document.body.style.overflow = '';
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.pf-modal-overlay.is-open').forEach((overlay) => {
        overlay.classList.remove('is-open');
      });
      document.body.style.overflow = '';
    }
  });
</script>