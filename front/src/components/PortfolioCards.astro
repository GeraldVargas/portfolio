    technologies: [
      { name: "Node.js", slug: "nodedotjs" },
      { name: "Express", slug: "express" },
      { name: "React", slug: "react" },
    ],
    demoUrl: "",
    repoUrl: "",
  },
  {
    id: "ferreteria-urkupina",
    title: "Ferretería Urkupiña",
    color: "ff9d00",
