    color: "ffd60a",
    description:
      "Aplicación móvil Android para técnicos de campo de la Cooperativa de Electricidad \u201c15 de Noviembre\u201d (Potosí). Registro de lecturas con geolocalización GPS, impresión automática de recibos térmicos vía Bluetooth ESC/POS, mapa interactivo de clientes con OpenStreetMap y backend en Laravel.",
    technologies: [
      { name: "Flutter", slug: "flutter" },
      { name: "Laravel", slug: "laravel" },
      { name: "Bluetooth", slug: "bluetooth" },
      { name: "OpenStreetMap", slug: "openstreetmap" },
    ],
    demoUrl: "",
