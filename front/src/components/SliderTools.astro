---
import "../styles/components/tools.css";
import toolsInfo from "../data/ToolsInfo.js";
---

{
	[...toolsInfo, ...toolsInfo].map((tool) => (
		<div class="tools__grupo">
			<div
				class="tools__link tools__caja caja__dark"
				tabindex="0"
				aria-label={tool.title}
				style={`--tool-color:${tool.color}; --tool-hover:${tool.hover}; --tool-ink:${tool.ink};`}
			>
				<div class="tools__logo">
					<img class="tools__icono tool__dark" src={tool.src} alt="" />
				</div>
				<span class="tools__descripcion">{tool.title}</span>
			</div>
		</div>
	))
}
