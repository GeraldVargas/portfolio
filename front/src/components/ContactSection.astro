---
import "../styles/components/contact.css";
---

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>

<section class="contact-section" id="contact">
  <div class="contact-container" data-aos="fade-up">
    <h2 class="contact-title btn-shine" data-i18n-key="contact_title">
      Contáctame
    </h2>
    <p class="contact-subtitle" data-i18n-key="contact_subtitle">
      Ponte en contacto para proyectos, colaboraciones o consultas
    </p>

    <div class="contact-layout">
      <video
        class="contact-video"
        src="/video/heroport.mp4"
        autoplay
        muted
        loop
        playsinline
        aria-label="Video de presentación de Gerald"
      ></video>

      <form class="contact-form" id="contact-form" novalidate>
        <div class="input-container">
          <input
            type="text"
            id="contact-name"
            name="name"
            placeholder="Tu Nombre"
            data-i18n-placeholder="contact_name_placeholder"
            required
          />
        </div>

        <div class="input-container">
          <input
            type="email"
            id="contact-email"
            name="email"
            placeholder="Tu Correo Electrónico"
            data-i18n-placeholder="contact_email_placeholder"
            required
          />
        </div>

        <div class="input-container">
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            placeholder="Tu Mensaje..."
            data-i18n-placeholder="contact_message_placeholder"
            required
          ></textarea>
        </div>

        <button type="submit" id="contact-submit-btn" class="contact-submit-btn" data-i18n-key="contact_send_btn">
          ENVIAR MENSAJE
        </button>

        <div class="contact-status" id="contact-status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  // ============================================
  // CONFIGURACIÓN DE EMAILJS
  // Reemplaza estos 3 valores con los tuyos de emailjs.com
  // ============================================
  const EMAILJS_PUBLIC_KEY  = "TU_PUBLIC_KEY";   // Account > General
  const EMAILJS_SERVICE_ID  = "TU_SERVICE_ID";   // Email Services
  const EMAILJS_TEMPLATE_ID = "TU_TEMPLATE_ID";  // Email Templates

  const form      = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusDiv = document.getElementById("contact-status") as HTMLElement | null;
  const submitBtn = document.getElementById("contact-submit-btn") as HTMLButtonElement | null;

  // Inicializa EmailJS con tu public key
  if (typeof window !== "undefined" && (window as any).emailjs) {
    (window as any).emailjs.init(EMAILJS_PUBLIC_KEY);
  }

  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const lang = document.documentElement.lang || "es";

      const name    = (document.getElementById("contact-name") as HTMLInputElement)?.value;
      const email   = (document.getElementById("contact-email") as HTMLInputElement)?.value;
      const message = (document.getElementById("contact-message") as HTMLTextAreaElement)?.value;

      if (submitBtn) submitBtn.disabled = true;
      if (statusDiv) {
        statusDiv.textContent = lang === "en" ? "Sending..." : "Enviando...";
      }

      (window as any).emailjs
        .send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, {
          name,
          email,
          message,
        })
        .then(() => {
          if (statusDiv) {
            statusDiv.textContent =
              lang === "en"
                ? "✓ Message sent! Thanks for reaching out."
                : "✓ ¡Mensaje enviado! Gracias por contactarme.";
          }
          form.reset();
          if (submitBtn) submitBtn.disabled = false;
        })
        .catch((error: any) => {
          console.error("EmailJS error:", error);
          if (statusDiv) {
            statusDiv.textContent =
              lang === "en"
                ? "✗ Something went wrong. Please try again."
                : "✗ Algo salió mal. Intenta de nuevo.";
          }
          if (submitBtn) submitBtn.disabled = false;
        });
    });
  }
</script>