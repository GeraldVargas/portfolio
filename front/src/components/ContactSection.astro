---
import "../styles/components/contact.css";
---

<section class="contact-section" id="contact">
  <div class="contact-container" data-aos="fade-up">
    <h2 class="contact-title btn-shine" data-i18n-key="contact_title">
      Contáctame
    </h2>
    <p class="contact-subtitle" data-i18n-key="contact_subtitle">
      Ponte en contacto para proyectos, colaboraciones o consultas
    </p>

    <div class="contact-layout">
      <video
        class="contact-video"
        src="/video/heroport.mp4"
        autoplay
        muted
        loop
        playsinline
        aria-label="Video de presentación de Gerald"
      ></video>

      <form class="contact-form" id="contact-form" novalidate>
        <div class="input-container">
          <input
            type="text"
            id="contact-name"
            name="name"
            placeholder="Tu Nombre"
            data-i18n-placeholder="contact_name_placeholder"
            required
          />
        </div>

        <div class="input-container">
          <input
            type="email"
            id="contact-email"
            name="email"
            placeholder="Tu Correo Electrónico"
            data-i18n-placeholder="contact_email_placeholder"
            required
          />
        </div>

        <div class="input-container">
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            placeholder="Tu Mensaje..."
            data-i18n-placeholder="contact_message_placeholder"
            required
          ></textarea>
        </div>

        <button type="submit" id="contact-submit-btn" class="contact-submit-btn" data-i18n-key="contact_send_btn">
          ENVIAR MENSAJE
        </button>

        <div class="contact-status" id="contact-status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  // ============================================
  // CONFIGURACIÓN DEL API
  // Define PUBLIC_API_URL en el .env del frontend
  // para apuntar al backend (por defecto localhost:4000)
  // ============================================
  const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4000";

  const form      = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusDiv = document.getElementById("contact-status") as HTMLElement | null;
  const submitBtn = document.getElementById("contact-submit-btn") as HTMLButtonElement | null;

  const setStatus = (text: string) => {
    if (statusDiv) statusDiv.textContent = text;
  };

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const lang = document.documentElement.lang || "es";

      const name    = (document.getElementById("contact-name") as HTMLInputElement)?.value.trim();
      const email   = (document.getElementById("contact-email") as HTMLInputElement)?.value.trim();
      const message = (document.getElementById("contact-message") as HTMLTextAreaElement)?.value.trim();

      if (!name || !email || !message) {
        setStatus(lang === "en" ? "Please fill in all fields." : "Completa todos los campos.");
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      setStatus(lang === "en" ? "Sending..." : "Enviando...");

      try {
        const res = await fetch(`${API_URL}/api/contact`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, email, message }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok || data.ok === false) {
          throw new Error(data.error || "Request failed");
        }

        setStatus(
          lang === "en"
            ? "✓ Message sent! Thanks for reaching out."
            : "✓ ¡Mensaje enviado! Gracias por contactarme."
        );
        form.reset();
      } catch (error: any) {
        console.error("Contact form error:", error);
        setStatus(
          lang === "en"
            ? "✗ Something went wrong. Please try again."
            : "✗ Algo salió mal. Intenta de nuevo."
        );
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>