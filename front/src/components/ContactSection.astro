---
import "../styles/components/contact.css";
---

<section class="contact-section" id="contact">
  <div class="contact-container" data-aos="fade-up">
    <h2 class="contact-title titulo--dev" data-i18n-key="contact_title">
      Contáctame
    </h2>
    <p class="contact-subtitle" data-i18n-key="contact_subtitle">
      Ponte en contacto para proyectos, colaboraciones o consultas
    </p>

    <div class="contact-layout">
      <video
        class="contact-video"
        src="/video/heroport.mp4"
        autoplay
        muted
        loop
        playsinline
        aria-label="Video de presentación de Gerald"
      ></video>

      <form class="contact-form" id="contact-form" novalidate>
        <div class="input-container">
          <input
            type="text"
            id="contact-name"
            name="name"
            placeholder="Tu Nombre"
            data-i18n-placeholder="contact_name_placeholder"
            required
          />
        </div>

        <div class="input-container">
          <input
            type="email"
            id="contact-email"
            name="email"
            placeholder="Tu Correo Electrónico"
            data-i18n-placeholder="contact_email_placeholder"
            required
          />
        </div>

        <div class="input-container">
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            placeholder="Tu Mensaje..."
            data-i18n-placeholder="contact_message_placeholder"
            required
          ></textarea>
        </div>

        <button type="submit" id="contact-submit-btn" class="contact-submit-btn btn3d" data-i18n-key="contact_send_btn">
          <span class="button-outer">
            <span class="button-inner">
              <span class="button-label">Enviar</span>
            </span>
          </span>
        </button>

        <div class="contact-status" id="contact-status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  // ============================================
  // Envío del mensaje vía WhatsApp
  // Edita WHATSAPP_NUMBER con tu número en formato
  // internacional sin "+" (código de país + número).
  // ============================================
  const WHATSAPP_NUMBER = "59176476507";

  const form      = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusDiv = document.getElementById("contact-status") as HTMLElement | null;

  const setStatus = (text: string) => {
    if (statusDiv) statusDiv.textContent = text;
  };

  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const lang = document.documentElement.lang || "es";

      const name    = (document.getElementById("contact-name") as HTMLInputElement)?.value.trim();
      const email   = (document.getElementById("contact-email") as HTMLInputElement)?.value.trim();
      const message = (document.getElementById("contact-message") as HTMLTextAreaElement)?.value.trim();

      if (!name || !email || !message) {
        setStatus(lang === "en" ? "Please fill in all fields." : "Completa todos los campos.");
        return;
      }

      const text = `Hola Gerald, soy ${name} (${email}).\n\n${message}`;
      const url  = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;

      window.open(url, "_blank", "noopener,noreferrer");
      setStatus(lang === "en" ? "Opening WhatsApp..." : "Abriendo WhatsApp...");
      form.reset();
    });
  }
</script>