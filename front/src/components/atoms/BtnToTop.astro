<script>
  /* Boton "To top" */
  const d = document;
  const cajaToTop = d.querySelector(".to__top") as HTMLElement;

  /* Dar click en en la caja del btn "toTop*/
  cajaToTop.addEventListener("click", () => {
    window.location.href = "#";
  });

  const toTop = d.querySelector(".to__top") as HTMLElement;
  window.addEventListener("scroll", () => {
    if (window.pageYOffset > 500) {
      toTop.classList.add("active");
    } else {
      toTop.classList.remove("active");
    }
  });
</script>

<div class="menu__flotante">
  <div class="icon__top-container">
    <button class="to__top" type="button" data-menu="float" aria-label="Volver al inicio">
      <span class="to__top-outer">
        <span class="to__top-inner"><i class="bi bi-arrow-up"></i></span>
      </span>
    </button>
  </div>
</div>
<style>
  /** @format */

  .menu__flotante {
    position: fixed;
    z-index: 999;
    bottom: 22%;
    right: -84%;
    width: 100%;
  }
  .to__top {
    display: flex;
    padding: 0;
    border: 0;
    width: 4rem;
    height: 4rem;
    opacity: 0;
    pointer-events: none;
    transition: all 0.4s;
    justify-content: center;
    align-items: center;
    backdrop-filter: blur(10px);
    background: rgba(20, 20, 20, 0.78);
    border-radius: 50%;
    box-shadow: -0.15em -0.15em 0.15em -0.075em rgba(5, 5, 5, 0.25), 0.0375em 0.0375em 0.0675em rgba(5, 5, 5, 0.1);
  }
  .to__top,
  .bi-arrow-up {
    cursor: pointer;
    font-size: 2.3rem;
    color: #2f2f2f;
  }
  .to__top-outer { position: relative; z-index: 1; display: grid; width: 100%; height: 100%; place-items: center; border-radius: inherit; box-shadow: 0 0.05em 0.05em -0.01em rgba(5, 5, 5, 1), 0 0.01em 0.01em -0.01em rgba(5, 5, 5, 0.5), 0.15em 0.3em 0.1em -0.01em rgba(5, 5, 5, 0.25); transition: box-shadow 300ms ease; }
  .to__top-inner { display: grid; width: 100%; height: 100%; place-items: center; border-radius: inherit; background: linear-gradient(135deg, #e6e6e6, #b4b4b4); clip-path: inset(0 round 50%); box-shadow: 0 0 0.05em 0.2em inset rgba(255, 255, 255, 0.25), 0.025em 0.05em 0.1em inset rgba(255, 255, 255, 1), -0.075em -0.25em 0.25em 0.1em inset rgba(5, 5, 5, 0.25); transition: box-shadow 300ms ease, clip-path 250ms ease; }
  .to__top:hover .to__top-outer { box-shadow: none; }
  .to__top:hover .to__top-inner { clip-path: inset(2px round 50%); box-shadow: 0.1em 0.15em 0.05em inset rgba(5, 5, 5, 0.75), -0.025em -0.03em 0.05em 0.025em inset rgba(5, 5, 5, 0.5), 0.25em 0.25em 0.2em inset rgba(5, 5, 5, 0.5), 0 0 0.05em 0.5em inset rgba(255, 255, 255, 0.15); }

  .to__top.active {
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 768px) {
    .menu__flotante {
      bottom: 34%;
      right: -93.8%;
    }
  }
  @media (min-width: 1200px) {
    .menu__flotante {
      bottom: 36%;
      right: -95.8%;
    }
    .icon__top-container {
      display: flex;
      position: absolute;
      z-index: 1;
    }
    .to__top {
      width: 4.8rem;
      height: 4.8rem;
    }
    .bi-arrow-up {
      font-size: 2.8rem;
      color: #2f2f2f;
    }
  }
</style>
