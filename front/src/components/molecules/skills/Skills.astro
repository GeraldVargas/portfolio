---
import CardSkill from "@molecules/skills/CardSkills";
import CardTerminal from "@layouts/CardTerminal.astro";
import Button from "@atoms/Button/Button.astro";
---

<section class="skills" id="skills">
  <h2 data-aos="fade-up" class="titulo titulo__dark">Skills</h2>
  <div class="skills__container max__width">
    <CardTerminal animation="fade-right">
      <p class="terminal__content terminal__content--p">
        ≥ Final-year
        <span class="terminal__content terminal__content--span"
          >Computer Engineering student</span
        >
        at Universidad Mayor de San Simón (UMSS).
      </p>
      <p class="terminal__content terminal__content--color">
        ≥ Strong foundation in Python, PHP, Laravel, Node.js, React, Flutter,
        MySQL, PostgreSQL, TensorFlow, Docker, and Astro.
      </p>
      <p class="terminal__content terminal__content--color">
        ≥ Experience in high-criticality projects: electoral systems, municipal
        apps, and educational platforms. Focused on Applied AI and Machine
        Learning.
      </p>
      <Button
        href="/docs/GeraldEmanuelVargas.pdf"
        text="Download CV"
        target="_blank"
      />
    </CardTerminal>
	  <div class="skills__cards-container">
	<CardSkill />
	</div>
  </div>
</section>
