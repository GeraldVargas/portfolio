---
import "./card-about.css";
---

<div class="about-card-parent" data-aos="fade-right">
  <article class="about-card" aria-label="Tarjeta de presentación de Gerald Vargas">
    <div class="about-card__glass"></div>
    <div class="about-card__content">
      <img class="about-card__avatar" src="/img/gerald1.png" alt="Gerald Vargas" loading="lazy" />
    </div>
    <div class="about-card__actions">
      <a class="about-card__action" href="mailto:geraldvargasmorales@gmail.com" aria-label="Enviar email" title="Enviar email">
        <span class="button-outer">
          <span class="button-inner">
            <svg class="about-card__svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 5H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm0 2v.5l-8 5-8-5V7h16Zm0 10H4V9.86l7.47 4.67a1 1 0 0 0 1.06 0L20 9.86V17Z"/></svg>
            <span data-i18n-key="card_email">Email</span>
          </span>
        </span>
      </a>
      <a class="about-card__action" href="/docs/cvGeraldVargas.pdf" download target="_blank" rel="noopener noreferrer" aria-label="Descargar CV" title="Descargar CV">
        <span class="button-outer">
          <span class="button-inner">
            <svg class="about-card__svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7l-5-5Zm0 2.5L16.5 7H14V4.5ZM7 20V4h5v4a1 1 0 0 0 1 1h4v11H7Zm5-1a1 1 0 0 0 1-1v-2.59l.3.3a1 1 0 1 0 1.4-1.42l-2-2a1 1 0 0 0-1.4 0l-2 2a1 1 0 1 0 1.4 1.42l.3-.3V18a1 1 0 0 0 1 1Z"/></svg>
            <span data-i18n-key="card_cv">Descargar CV</span>
          </span>
        </span>
      </a>
    </div>
  </article>
</div>
