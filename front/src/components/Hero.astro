---
import "../styles/components/hero.css";
---
<section class="hero" id="hero" transition:persist>
  <video
    class="hero__video"
    src="/video/heroport.mp4"
    autoplay
    loop
    muted
    playsinline
  ></video>
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <p class="hero__greeting">≥ Hi! I'm</p>
    <h1 class="hero__name">Gerald Vargas</h1>
    <h2 class="hero__role">≥ Full Stack Developer · Applied AI</h2>
    <h3 class="hero__sub">Computer Engineering Student · Cochabamba, Bolivia</h3>
  </div>
</section>
