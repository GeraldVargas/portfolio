---
import "../styles/components/hero.css";
---
<section class="hero" id="hero" transition:persist>
  <div class="hero__overlay"></div>
  <div class="hero__container">
    <div class="hero__content">
      <p class="hero__greeting hero__glitch" data-text="≥ Hi! I'm">≥ Hi! I'm</p>
      <h1 class="hero__name hero__glitch" data-text="Gerald Vargas">Gerald Vargas</h1>
      <h2 class="hero__role hero__glitch" data-text="≥ Full Stack Developer · Applied AI">≥ Full Stack Developer · Applied AI</h2>
      <h3 class="hero__sub hero__glitch" data-text="Computer Engineering Student · Cochabamba, Bolivia">Computer Engineering Student · Cochabamba, Bolivia</h3>
      <div class="hero__socials" aria-label="Redes sociales">
        <a
          class="hero__social-btn"
          href="https://github.com/GeraldVargas"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <i class="bi bi-github"></i>
          <span>GitHub</span>
        </a>
        <a
          class="hero__social-btn"
          href="https://www.instagram.com/gerald__vargas__/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <i class="bi bi-instagram"></i>
          <span>Instagram</span>
        </a>
        <a
          class="hero__social-btn"
          href="https://www.linkedin.com/in/gerald-emanuel-vargas-morales-42b44332a/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <i class="bi bi-linkedin"></i>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
    <figure class="hero__bubble" aria-label="Gerald hero">
      <div class="loader-wrapper" aria-hidden="true">
        <div class="loader" aria-hidden="true"></div>
      </div>
      <img class="hero__avatar" src="/img/portfolio_img/geraldhero.png" alt="Gerald hero" loading="eager" />
    </figure>
  </div>
  <div class="hero__wave">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path
        fill="rgb(228, 228, 228)"
        fill-opacity="1"
        d="M0,64 C360,120 1080,0 1440,80 L1440,120 L0,120 Z"
      />
    </svg>
  </div>
</section>
