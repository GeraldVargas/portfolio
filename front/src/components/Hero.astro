---
import "../styles/components/hero.css";
import { cardsData } from "../data/skillsMastered";

const orbitSkills = cardsData;
const orbitPositions = [
  { x: 50, y: -4 },
  { x: 76, y: 8 },
  { x: 102, y: 30 },
  { x: 104, y: 58 },
  { x: 84, y: 86 },
  { x: 58, y: 104 },
  { x: 30, y: 92 },
  { x: -4, y: 70 },
  { x: -2, y: 42 },
  { x: 16, y: 14 },
  { x: 36, y: -2 },
  { x: 70, y: 96 },
];
---
<section class="hero" id="hero" transition:persist>
  <div class="hero__overlay"></div>
  <div class="hero__container">
    <div class="hero__content">
      <p class="hero__greeting hero__glitch" data-text="≥ Hi! I'm">≥ Hi! I'm</p>
      <h1 class="hero__name hero__glitch" data-text="Gerald Vargas">Gerald Vargas</h1>
      <h2 class="hero__role hero__glitch" data-text="≥ Full Stack Developer · Applied AI">≥ Full Stack Developer · Applied AI</h2>
      <h3 class="hero__sub hero__glitch" data-text="Computer Engineering Student · Cochabamba, Bolivia">Computer Engineering Student · Cochabamba, Bolivia</h3>
      <div class="hero__socials" aria-label="Redes sociales">
        <a
          class="hero__social-btn"
          href="https://github.com/GeraldVargas"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <i class="bi bi-github"></i>
          <span>GitHub</span>
        </a>
        <a
          class="hero__social-btn"
          href="https://www.instagram.com/gerald__vargas__/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <i class="bi bi-instagram"></i>
          <span>Instagram</span>
        </a>
        <a
          class="hero__social-btn"
          href="https://www.linkedin.com/in/gerald-emanuel-vargas-morales-42b44332a/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <i class="bi bi-linkedin"></i>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
    <div class="hero__media">
      <figure class="hero__bubble" aria-label="Gerald hero">
        <div class="loader-wrapper" aria-hidden="true">
          <div class="loader" aria-hidden="true"></div>
        </div>
        <img class="hero__avatar" src="/img/portfolio_img/geraldhero.png" alt="Gerald hero" loading="eager" />
      </figure>
      <div class="hero__orbit" aria-hidden="true">
        {
          orbitSkills.map((skill, index) => {
            const position = orbitPositions[index % orbitPositions.length];
            return (
              <div
                class="hero__orbit-item"
                style={`--orbit-x:${position.x}%; --orbit-y:${position.y}%; --orbit-delay:${index * 0.12}s;`}
              >
                <div class="hero__orbit-skill">
                  <img
                    class={`hero__orbit-icon ${skill.clas}`}
                    src={skill.imgSrc}
                    alt=""
                    loading="lazy"
                  />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
  <div class="hero__wave">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path
        fill="rgb(228, 228, 228)"
        fill-opacity="1"
        d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z"
      />
    </svg>
  </div>
</section>
