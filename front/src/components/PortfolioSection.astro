---
import "../styles/pages/portfolio.css"
import PortfolioCards from "./PortfolioCards.astro";
import Button from "@atoms/Button/Button.astro";

---


    <section class="portafolio " id="portafolio">
            <h2 data-aos="fade-left" class="titulo titulo__dark btn-shine" data-i18n-key="portfolio_title">Portfolio</h2>
            <div class="portafolio__contenedor" data-card>
                <PortfolioCards limit={3} />
            </div>
            <Button
                animation="zoom-in"
                href="/portfolio"
                text="See More"
                data-i18n-key="portfolio_see_more"
            />
        </section>