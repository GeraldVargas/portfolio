---
import MainLogo from "./MainLogo.astro";
import "../styles/components/footer.css"

---
<footer class="footer">
	<div class="footer__container">
		<MainLogo/>
		<div class="foooter__cajas">
		</div>
		<div class="foooter__cajas">
			<ul class="footer__caja__links">
				<li class="footer__links"><a href="https://github.com/GeraldVargas" class="footer__link"
						target="_blank" rel="nofollow noreferrer noopener">GitHub</a></li>
				<li class="footer__links"><a href="https://www.linkedin.com/in/gerald-emanuel-vargas-morales-42b44332a/" class="footer__link"
						target="_blank" rel="nofollow noreferrer noopener">LinkedIn</a></li>
				<li class="footer__links"><a href="mailto:geraldvargasmorales@gmail.com" class="footer__link"
						target="_blank" rel="nofollow noreferrer noopener" data-i18n-key="footer_email">Email</a></li>
			</ul>
		</div>
		<div class="foooter__cajas">
			<ul class="footer__caja__iconos">
				<li class="footer__iconos__lista ">
					<a class="footer__social-btn" href="mailto:geraldvargasmorales@gmail.com" rel="nofollow noreferrer noopener" aria-label="Email">
						<img class="footer__iconos mail__footer icono__dark" src="/svg/mail (1).svg"
							alt="Email">
						<span>Email</span>
					</a>
				</li>
				<li class="footer__iconos__lista ">
					<a class="footer__social-btn" href="https://www.linkedin.com/in/gerald-emanuel-vargas-morales-42b44332a/" target="_blank"
						rel="nofollow noreferrer noopener" aria-label="LinkedIn">
						<img class="footer__iconos linkedin__footer icono__dark" src="/svg/linkedin.svg"
							alt="LinkedIn">
						<span>LinkedIn</span>
					</a>
				</li>
				<li class="footer__iconos__lista ">
					<a class="footer__social-btn" href="https://github.com/GeraldVargas" target="_blank" rel="nofollow noreferrer noopener" aria-label="GitHub">
						<img class="footer__iconos  icono__dark" src="/svg/github-light.svg"
							alt="GitHub">
						<span>GitHub</span>
					</a>
				</li>
			</ul>
		</div>
	</div>
</footer>
