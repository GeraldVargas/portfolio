---
import "./about-home.css";
import CardTerminal from "@layouts/CardTerminal.astro";
import CardAbout from "@molecules/CardAbout/CardAbout.astro";
import TitleSpan from "@atoms/TitleSpan/TitleSpan.astro";
---

<section class="about" id="about">
	<TitleSpan  text1="Who is Gerald" span="Dev" text2="?" />
	<div class="about__container">
		<CardAbout />
		<div class="terminal__container">
			<CardTerminal animation="fade-left" variant="about-modern">
				<h3 class="terminal__content terminal__content--h3" data-i18n-key="terminal_h3_1">≥ Gerald Emanuel Vargas</h3>
				<p class="terminal__content terminal__content--p" data-i18n-key="terminal_p_1">≥ Python & Laravel fan 🤖. Always building things that matter.</p>

				<h3 class="terminal__content terminal__content--h3">
					<span data-i18n-key="terminal_h3_2_pre">≥ What </span><span class="terminal__content terminal__content--span span__dark" data-i18n-key="terminal_h3_2_span">sets me apart?</span>
				</h3>
				<p class="terminal__content terminal__content--p" data-i18n-key="terminal_p_2">
					≥ I've deployed real systems used in official elections 🗳️ and
					municipal governments. I build for production, not just for practice.
				</p>
			</CardTerminal>
		</div>

	</div>
</section>
