---
import "./about-home.css";
import Button from "@atoms/Button/Button.astro";
import CardTerminal from "@layouts/CardTerminal.astro";
import CardAbout from "@molecules/CardAbout/CardAbout.astro";
import TitleSpan from "@atoms/TitleSpan/TitleSpan.astro";
---

<section class="about" id="about">
	<TitleSpan  text1="Who is Gerald" span="Dev" text2="?" />
	<div class="about__container">
		<CardAbout />
		<div class="terminal__container">
			<CardTerminal animation="fade-left">
				<h3 class="terminal__content terminal__content--h3">≥ Gerald Emanuel Vargas</h3>
				<p class="terminal__content terminal__content--p">≥ Python & Laravel fan 🤖. Always building things that matter.</p>

				<h3 class="terminal__content terminal__content--h3">
					≥ What <span class="terminal__content terminal__content--span span__dark">sets me apart?</span>
				</h3>
				<p class="terminal__content terminal__content--p">
					≥ I've deployed real systems used in official elections 🗳️ and
					municipal governments. I build for production, not just for practice.
				</p>
				<div class="about__contactar">
					<Button href="/about" text="See more" />
				</div>
			</CardTerminal>
		</div>

	</div>
</section>
